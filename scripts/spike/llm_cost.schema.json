{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunera.dev/schema/llm_cost_v1.json",
  "title": "Артефакт замера стоимости LLM — Лунора, гейт G17-S3b",
  "description": "Форма машинного артефакта живого замера. Заполняется один раз и коммитится; проверяется офлайн-режимом --check против порогов. Ключи верхнего уровня и состав сценариев зафиксированы оркестратором.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measured_at",
    "provider",
    "model",
    "pricing",
    "scenarios",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "measured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Дата замера, UTC."
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "Провайдер и канал: например openrouter, anthropic, посредник."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Идентификатор модели в рантайме, как в LUNORA_LLM_MODEL."
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_usd_per_1m",
        "output_usd_per_1m",
        "usd_rub_rate",
        "intermediary_markup",
        "priced_on"
      ],
      "properties": {
        "input_usd_per_1m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Цена входных токенов, USD за 1 000 000."
        },
        "output_usd_per_1m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Цена выходных токенов, USD за 1 000 000."
        },
        "usd_rub_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Курс USD→RUB на день замера."
        },
        "intermediary_markup": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Наценка посредника. В бюджете 05_business.md §3.1 принято 1.5."
        },
        "priced_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Дата, на которую взяты цены и курс."
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runs",
          "cards",
          "calls_per_card",
          "usage",
          "cost_rub"
        ],
        "properties": {
          "id": {
            "enum": ["dialog", "document", "forecast"],
            "description": "dialog — вопрос в диалоге; document — документ-синтез «Мы с ним»; forecast — утренний прогноз."
          },
          "runs": {
            "type": "integer",
            "minimum": 1,
            "description": "Сколько раз повторён сценарий. Методика требует 3."
          },
          "cards": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Идентификаторы карт A–E, на которых гоняли сценарий."
          },
          "calls_per_card": {
            "type": "integer",
            "minimum": 1,
            "description": "Сколько вызовов модели на карту: диалог 25, документ 1, прогноз 7."
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_tokens", "output_tokens"],
            "properties": {
              "input_tokens": {
                "$ref": "#/$defs/dist"
              },
              "output_tokens": {
                "$ref": "#/$defs/dist"
              }
            }
          },
          "cost_rub": {
            "$ref": "#/$defs/dist",
            "description": "Себестоимость сценария в рублях по формуле 05_business.md §3.1."
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["within_budget", "threshold_variant", "notes"],
      "properties": {
        "within_budget": {
          "type": "boolean",
          "description": "Все сценарии, у которых есть порог, уложились в бюджет."
        },
        "threshold_variant": {
          "enum": ["A", "B"],
          "description": "Вариант порогов, против которого вынесен вердикт: A — Haiku (§3.1), B — топовая модель (§3.5)."
        },
        "notes": {
          "type": "string",
          "description": "Что мешало чистому замеру: отклонённые прогоны, ретраи, смена модели в середине."
        }
      }
    }
  },
  "$defs": {
    "dist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p90"],
      "properties": {
        "median": {
          "type": "number",
          "minimum": 0
        },
        "p90": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
