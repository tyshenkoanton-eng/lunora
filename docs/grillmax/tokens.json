{
  "$meta": { "project": "Лунора", "palette": "mint", "default_theme": "light", "source": "G9 visual system", "status": "system_locked_visual_conditional" },
  "primitive": {
    "mint": { "paper": "#F6F2EA", "card": "#FFFCF7", "ink": "#202924", "ink_soft": "#56625A",
              "green": "#28554D", "green_soft": "#E4EDE7", "copper": "#965735", "rule": "#D3DBD2",
              "paper_d": "#161D1B", "card_d": "#1E2925", "ink_d": "#EFEFE5", "ink_soft_d": "#B6C3B9",
              "green_d": "#A8CDBD", "green_soft_d": "#2B3C34", "copper_d": "#DCAE8A", "rule_d": "#45564C" },
    "status": { "success": "#2E7D5B", "success_d": "#8FD3B0", "error": "#A13F45", "error_d": "#EEA7AB",
                "caution": "#A8841E", "caution_d": "#E6C27A" },
    "school": { "west": "#4C5BA6", "ved": "#BE7E2A", "bazi": "#2C8A9E", "num": "#8A5A9B" },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "grid": "8px" },
    "radius": { "sm": "10px", "md": "14px", "lg": "16px", "pill": "999px" },
    "type": { "base": "16px", "scale": 1.25, "family": "Lunera/system (от оператора)" }
  },
  "semantic": {
    "light": { "bg": "{mint.paper}", "surface": "{mint.card}", "text": "{mint.ink}", "text_soft": "{mint.ink_soft}",
      "accent": "{mint.green}", "on_accent": "{mint.card}", "accent_bg": "{mint.green_soft}", "rule": "{mint.rule}",
      "decor": "{mint.copper}", "success": "{status.success}", "error": "{status.error}", "caution": "{status.caution}" },
    "dark": { "bg": "{mint.paper_d}", "surface": "{mint.card_d}", "text": "{mint.ink_d}", "text_soft": "{mint.ink_soft_d}",
      "accent": "{mint.green_d}", "on_accent": "{mint.paper_d}", "accent_bg": "{mint.green_soft_d}", "rule": "{mint.rule_d}",
      "decor": "{mint.copper_d}", "success": "{status.success_d}", "error": "{status.error_d}", "caution": "{status.caution_d}" },
    "school": { "west": "{school.west}", "ved": "{school.ved}", "bazi": "{school.bazi}", "num": "{school.num}" }
  },
  "component": {
    "button_primary": { "bg": "{accent}", "fg": "{on_accent}", "radius": "{radius.lg}" },
    "button_ghost": { "bg": "transparent", "fg": "{text}", "border": "{rule}" },
    "input": { "bg": "{surface}", "border": "{rule}", "error_border": "{error}" },
    "chip_school": { "dot": "{school.*}", "label_required": true },
    "toast": { "success_bg": "#E3EFE7", "error_bg": "#F4E4E3", "caution_bg": "#F3E9CF" }
  },
  "rules": {
    "color_not_alone": "каждый статус/школа — с подписью или иконкой",
    "copper_decor_only": true,
    "token_driven_frontend": "ADR-003: UI собирается из токенов+компонентов, без хардкода"
  }
}
